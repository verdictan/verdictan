# SPDX-License-Identifier: BUSL-1.1
# The build context must contain a verified cargo-dist payload at CLI_PAYLOAD_DIR.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

ARG VERDICTAN_COMMIT_SHA=unknown
ARG CLI_PAYLOAD_DIR=dist-payload/cli

LABEL org.opencontainers.image.licenses="BUSL-1.1" \
    org.opencontainers.image.revision="${VERDICTAN_COMMIT_SHA}" \
    org.opencontainers.image.source="https://github.com/verdictan/verdictan" \
    org.opencontainers.image.title="Verdictan Gateway CLI"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 verdictan-gateway \
    && useradd --uid 10001 --gid verdictan-gateway --home-dir /nonexistent \
        --no-create-home --shell /usr/sbin/nologin verdictan-gateway \
    && install -d -o 10001 -g 10001 /var/lib/verdictan/gateway

WORKDIR /app

COPY --chown=0:0 ${CLI_PAYLOAD_DIR}/rootfs/ /
COPY --chown=0:0 ${CLI_PAYLOAD_DIR}/payload-manifest.json \
    /usr/share/verdictan/payload-manifest.json
COPY --chown=0:0 ${CLI_PAYLOAD_DIR}/sbom.spdx.json \
    /usr/share/verdictan/sbom.spdx.json
COPY --chown=0:0 ${CLI_PAYLOAD_DIR}/provenance.json \
    /usr/share/verdictan/provenance.json

ENV HOME=/tmp
USER 10001:10001

ENTRYPOINT ["verdictan"]
CMD ["--help"]
